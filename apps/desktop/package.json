{
  "name": "trove-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for browsing and managing a Trove workspace.",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "predev": "pnpm --filter trove-contracts build && pnpm --filter trove-core build && pnpm rebuild:native",
    "build": "electron-vite build --outDir dist",
    "dev": "electron-vite dev",
    "prebuild": "pnpm --filter trove-contracts build && pnpm --filter trove-core build && pnpm rebuild:native",
    "preview": "electron-vite preview --outDir dist",
    "prepreview": "pnpm --filter trove-contracts build && pnpm --filter trove-core build && pnpm rebuild:native",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist out"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "trove-contracts": "workspace:*",
    "trove-core": "workspace:*"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.1.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
