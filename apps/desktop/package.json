{
  "name": "trove-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "Electron desktop shell for browsing and managing a Trove workspace.",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "build:icon": "node scripts/build-icon.mjs",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "predev": "pnpm --filter trove-contracts build && pnpm --filter trove-core build && pnpm rebuild:native",
    "build": "electron-vite build --outDir dist",
    "dev": "TROVE_HOME=../../.tmp/local-dev/workspace electron-vite dev",
    "dev:onboarding": "VITE_TROVE_FORCE_ONBOARDING=1 TROVE_HOME=../../.tmp/local-dev/workspace electron-vite dev",
    "prebuild": "pnpm --filter trove-contracts build && pnpm --filter trove-core build && pnpm rebuild:native",
    "dist:mac": "pnpm build && pnpm build:icon && electron-builder --config electron-builder.yml --mac dmg zip --arm64 --publish never",
    "dist:mac:dir": "pnpm build && pnpm build:icon && electron-builder --config electron-builder.yml --mac dir --arm64 --publish never",
    "preview": "electron-vite preview --outDir dist",
    "prepreview": "pnpm --filter trove-contracts build && pnpm --filter trove-core build && pnpm rebuild:native",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist out src/renderer/dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@ridemountainpig/svgl-react": "^1.0.16",
    "central-icons": "npm:@central-icons-react/round-outlined-radius-3-stroke-1.5@^1.1.179",
    "central-icons-bold": "npm:@central-icons-react/round-outlined-radius-3-stroke-2@^1.1.179",
    "central-icons-filled": "npm:@central-icons-react/round-filled-radius-3-stroke-1.5@^1.1.179",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "ogl": "^1.0.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "trove-contracts": "workspace:*",
    "trove-core": "workspace:*"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
