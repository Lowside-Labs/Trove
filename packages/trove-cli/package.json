{
  "name": "trove",
  "version": "0.1.2",
  "description": "Turn your saved web material into a local knowledge workspace for AI agents.",
  "keywords": [
    "archive",
    "bookmarks",
    "cli",
    "hacker-news",
    "search",
    "sqlite",
    "substack",
    "typescript",
    "x"
  ],
  "homepage": "https://github.com/Lowside-Labs/Trove",
  "bugs": {
    "url": "https://github.com/Lowside-Labs/Trove/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lowside-Labs/Trove.git"
  },
  "bin": {
    "trove": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node22 --dts --clean",
    "dev": "NODE_OPTIONS=--conditions=development tsx src/cli.ts",
    "dev:local": "NODE_OPTIONS=--conditions=development tsx scripts/dev-local.ts",
    "reset-local": "NODE_OPTIONS=--conditions=development tsx scripts/reset-local.ts",
    "test": "NODE_OPTIONS=--conditions=development vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "trove-contracts": "workspace:*",
    "trove-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
