{
  "name": "trove-workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/run-trove-entry.mjs src/cli.ts",
    "dev:local": "node scripts/run-trove-entry.mjs scripts/dev-local.ts",
    "reset-local": "node scripts/run-trove-entry.mjs scripts/reset-local.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "turbo": "^2.9.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.9.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
